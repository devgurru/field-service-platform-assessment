{
  "name": "field-service-platform-assessment",
  "version": "1.0.0",
  "private": true,
  "description": "Original React / Next.js and Supabase evaluation sample with synthetic payroll fixtures.",
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "test": "deno test --allow-read=tests/fixtures tests/payroll.test.ts tests/handler.test.ts",
    "test:db": "node scripts/test-database.mjs",
    "test:ui": "playwright test",
    "check:public": "node scripts/check-public.mjs",
    "check": "npm run typecheck && npm test && npm run check:public"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "next": "16.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0"
  }
}
